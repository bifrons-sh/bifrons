# Git metadata — never shipped in build context.
.git
.gitignore
.gitattributes

# Local build artefacts.
bin/
coverage*.out

# Specs / docs / IDE noise — not needed to compile.
specs/
.claude/
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Large e2e fixtures (tests themselves don't run in the image).
e2e/testdata/

# UI stage rebuilds the bundle from source — never ship host artefacts
# or the pnpm cache into the build context.
portal/ui/node_modules/
portal/internal/api/ui/dist/

# Dockerfiles don't need to ship inside the image.
**/Dockerfile
.dockerignore
