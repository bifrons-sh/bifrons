{
  "realm": "portal-demo",
  "displayName": "Access Portal Demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": { "realm": [], "client": {} },
  "groups": [
    { "name": "admins", "path": "/admins" },
    { "name": "engineers", "path": "/engineers" },
    { "name": "validators", "path": "/validators" },
    { "name": "dba-prod", "path": "/dba-prod" }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "alice",
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "groups": ["/admins", "/dba-prod"]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "bob",
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Engineer",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "groups": ["/engineers"]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "carol",
      "email": "carol@example.test",
      "firstName": "Carol",
      "lastName": "Engineer",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "groups": ["/engineers"]
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "david",
      "email": "david@example.test",
      "firstName": "David",
      "lastName": "Validator",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "david", "temporary": false }],
      "groups": ["/validators", "/dba-prod"]
    },
    {
      "id": "55555555-5555-5555-5555-555555555555",
      "username": "eve",
      "email": "eve@example.test",
      "firstName": "Eve",
      "lastName": "Newbie",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "eve", "temporary": false }],
      "groups": ["/engineers"]
    }
  ],
  "clients": [
    {
      "clientId": "portal",
      "name": "Access Portal (confidential)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "portal-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:18080/oidc/callback",
        "http://localhost:18080/oidc/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:18080",
        "http://localhost:18080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:18080/ui/##http://localhost:18080/ui/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
